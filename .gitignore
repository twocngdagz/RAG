.venv/
.idea/

__pycache__/
*.py[cod]
*$py.class

.env
.env.*
!.env.example

storage/
# Playwright persistent Chrome profile for the ChatGPT driver — contains live
# session cookies/auth. Never commit.
.chatgpt-profile/
# Ignore generated artifacts in output/, but track the accepted per-chapter
# learning materials. (output/* rather than output/ so specific files can be
# re-included -- git cannot un-ignore a file whose parent dir is wholly ignored.)
output/*
!output/pte.chapter*.book_learning_materials.json
!output/pte.chapter*.enrichment.json
outputs/
tmp/

input/pdfs/*.pdf
extracted/*.json
extracted/*.txt
!output/essay_prompts.json
!output/swt_passages.json
!output/describe_image_items.json
